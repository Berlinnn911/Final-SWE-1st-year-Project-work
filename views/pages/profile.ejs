<%#
  Finland Ice Hockey Tournament Platform
  File: views/pages/profile.ejs
  Author: Muhammad Abdullah (Authentication and User Profile)
  Purpose: Account profile view and edit form (name, email, age, location, bio)
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <% const title = 'Profile · Finland Ice Hockey'; %>
  <%- include('../partials/head', { title }) %>
</head>
<body>
  <%- include('../partials/navbar', { page, user: typeof user !== 'undefined' ? user : null }) %>

  <main>
    <section class="page-banner">
      <div class="container page-banner__inner">
        <h1>Profile</h1>
        <p>Manage your account information.</p>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container" style="max-width: 720px; margin-inline: auto;">
        <% if (error) { %>
          <div class="alert alert--error">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> <%= error %>
          </div>
        <% } %>

        <div class="profile-head fade-in">
          <div class="profile-head__avatar"><%= user.name.charAt(0).toUpperCase() %></div>
          <div style="flex: 1;">
            <div class="profile-head__name"><%= user.name %></div>
            <div class="profile-head__email"><%= user.email %></div>
            <div style="margin-top: 6px;">
              <span style="font-size: 11px; background: var(--light-ice-blue); color: var(--finland-blue); padding: 4px 10px; border-radius: 999px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
                <%= user.role %>
              </span>
            </div>
          </div>
        </div>

        <form action="/profile" method="POST" class="detail__card" style="margin-top: var(--space-3);">
          <h3>Account Details</h3>

          <div class="field">
            <label class="field__label" for="name">Full Name</label>
            <input class="input" type="text" id="name" name="name" value="<%= user.name %>" required maxlength="80" />
          </div>
          <div class="field">
            <label class="field__label" for="email">Email</label>
            <input class="input" type="email" id="email" name="email" value="<%= user.email %>" required />
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2);">
            <div class="field">
              <label class="field__label" for="age">Age</label>
              <input class="input" type="number" id="age" name="age" value="<%= user.age || '' %>" min="13" max="100" />
            </div>
            <div class="field">
              <label class="field__label" for="location">Location</label>
              <input class="input" type="text" id="location" name="location" value="<%= user.location || '' %>" placeholder="Helsinki" maxlength="80" />
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="bio">Bio</label>
            <textarea class="input" id="bio" name="bio" rows="3" placeholder="Tell us about yourself..." maxlength="500"><%= user.bio || '' %></textarea>
          </div>

          <div style="display: flex; gap: var(--space-1); justify-content: flex-end;">
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </div>
        </form>

        <div class="detail__card" style="margin-top: var(--space-3); border-top: 4px solid var(--error-red);">
          <h3>Sign Out</h3>
          <p style="margin-bottom: var(--space-2);">End your current session.</p>
          <form action="/signout" method="POST">
            <button type="submit" class="btn btn-secondary">
              <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
              Sign Out
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js" defer></script>
</body>
</html>

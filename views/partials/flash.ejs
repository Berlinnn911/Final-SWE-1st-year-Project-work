<%#
  Finland Ice Hockey Tournament Platform
  File: views/partials/flash.ejs
  Author: Rayyan Shakeel (Frontend Designer and UI Foundation)
  Purpose: Floating toast messages. Reads res.locals.flash provided by the
           flash middleware and renders one alert per message.
%>
<% if (typeof flash !== 'undefined' && flash && flash.length) { %>
  <div class="flash-stack" role="status" aria-live="polite">
    <% flash.forEach(function(f) { %>
      <div class="alert alert--<%= f.type === 'error' ? 'error' : 'success' %>">
        <i class="fa-solid <%= f.type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check' %>" aria-hidden="true"></i>
        <%= f.message %>
      </div>
    <% }) %>
  </div>
<% } %>

<%#
  Finland Ice Hockey Tournament Platform
  File: views/partials/navbar.ejs
  Author: Rayyan Shakeel (Frontend Designer and UI Foundation)
  Purpose: Top navigation bar. Shows public links when logged out and the
           full app menu (Tournaments, Teams, Dashboard, user chip, Sign Out)
           when logged in.
%>
<header class="navbar" id="navbar">
  <div class="container navbar__inner">
    <a href="/" class="navbar__brand" aria-label="Finland Ice Hockey home">
      <span class="navbar__logo" aria-hidden="true">
        <i class="fa-solid fa-hockey-puck"></i>
      </span>
      <span>Finland Ice Hockey</span>
    </a>

    <nav class="navbar__links" id="primaryNav" aria-label="Primary">
      <% if (user) { %>
        <a href="/" class="navbar__link <%= page === 'home' ? 'is-active' : '' %>">Home</a>
        <a href="/tournaments" class="navbar__link <%= page === 'tournaments' ? 'is-active' : '' %>">Tournaments</a>
        <a href="/teams" class="navbar__link <%= page === 'teams' ? 'is-active' : '' %>">Teams</a>
        <a href="/dashboard" class="navbar__link <%= page === 'dashboard' ? 'is-active' : '' %>">Dashboard</a>
        <% if (user.role === 'organizer' || user.role === 'admin') { %>
          <a href="/tournaments/new" class="navbar__link">+ Tournament</a>
        <% } %>

        <div class="navbar__user">
          <a href="/profile" class="navbar__user-chip <%= page === 'profile' ? 'is-active' : '' %>">
            <span class="navbar__user-avatar"><%= (user.name || 'P').charAt(0).toUpperCase() %></span>
            <span class="navbar__user-name"><%= user.name %></span>
          </a>
          <form action="/signout" method="POST" class="navbar__signout-form" data-no-loading>
            <button type="submit" class="btn btn-ghost btn-sm" aria-label="Sign out">
              <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
              <span>Sign Out</span>
            </button>
          </form>
        </div>
      <% } else { %>
        <a href="/" class="navbar__link <%= page === 'home' ? 'is-active' : '' %>">Home</a>
        <a href="/about" class="navbar__link <%= page === 'about' ? 'is-active' : '' %>">About</a>
        <a href="/signin" class="btn btn-ghost btn-sm">Sign In</a>
        <a href="/signup" class="btn btn-secondary btn-sm">Sign Up</a>
      <% } %>
    </nav>

    <div class="navbar__actions">
      <button
        class="navbar__toggle"
        id="navToggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-controls="primaryNav"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<%- include('flash') %>

